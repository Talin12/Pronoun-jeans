# Base URL of the Django API, with a trailing slash.
#
# Required at BUILD time, not just at runtime: scripts/prerender.mjs and
# scripts/generate-sitemap.mjs read the live catalogue through it to work out
# which product and category pages exist. `npm run build` fails loudly without
# it rather than shipping a site with no product pages.
VITE_API_URL=https://pronoun-jeans.onrender.com/api/

# Public origin, used for canonicals, Open Graph URLs and sitemap entries.
# Defaults to https://www.pronounjeans.com when unset; set it on preview
# deployments so they point at themselves.
VITE_SITE_URL=

# Optional. Path to a Chrome/Chromium binary for the prerenderer.
# Only needed when Playwright is not installed and Chrome is somewhere the
# script does not look — see scripts/lib/browser.mjs.
CHROME_PATH=
