{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "pronounjeans.com"
        }
      ],
      "destination": "https://www.pronounjeans.com/$1",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/shop/:path*",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/product-category/boxers",
      "destination": "/catalog/boxers",
      "permanent": true
    },
    {
      "source": "/product-category/boxers/:rest*",
      "destination": "/catalog/boxers",
      "permanent": true
    },
    {
      "source": "/product-category/travel-wear-pant",
      "destination": "/catalog/travel-wear-pant",
      "permanent": true
    },
    {
      "source": "/product-category/travel-wear-pant/:rest*",
      "destination": "/catalog/travel-wear-pant",
      "permanent": true
    },
    {
      "source": "/product-category/cargo-pant",
      "destination": "/catalog/cargo-pant",
      "permanent": true
    },
    {
      "source": "/product-category/cargo-pant/:rest*",
      "destination": "/catalog/cargo-pant",
      "permanent": true
    },
    {
      "source": "/product-category/shorts",
      "destination": "/catalog/shorts",
      "permanent": true
    },
    {
      "source": "/product-category/shorts/:rest*",
      "destination": "/catalog/shorts",
      "permanent": true
    },
    {
      "source": "/product-category/formal-pants",
      "destination": "/catalog/formal-pants",
      "permanent": true
    },
    {
      "source": "/product-category/formal-pants/:rest*",
      "destination": "/catalog/formal-pants",
      "permanent": true
    },
    {
      "source": "/product-category/co-ord-set",
      "destination": "/catalog/co-ord-set",
      "permanent": true
    },
    {
      "source": "/product-category/co-ord-set/:rest*",
      "destination": "/catalog/co-ord-set",
      "permanent": true
    },
    {
      "source": "/product-category/cotton-trousers",
      "destination": "/catalog/cotton-trousers",
      "permanent": true
    },
    {
      "source": "/product-category/cotton-trousers/:rest*",
      "destination": "/catalog/cotton-trousers",
      "permanent": true
    },
    {
      "source": "/product-category/:path*",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/brand",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/brand/:path*",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/product-tag",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/product-tag/:path*",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/my-account",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/my-account/:path*",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "/cart",
      "permanent": true
    },
    {
      "source": "/checkout/:path*",
      "destination": "/cart",
      "permanent": true
    },
    {
      "source": "/basket",
      "destination": "/cart",
      "permanent": true
    },
    {
      "source": "/basket/:path*",
      "destination": "/cart",
      "permanent": true
    },
    {
      "source": "/wp-admin",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-content/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-includes/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/comments/feed",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/catalog",
      "destination": "/app.html"
    },
    {
      "source": "/about",
      "destination": "/app.html"
    },
    {
      "source": "/contact",
      "destination": "/app.html"
    },
    {
      "source": "/terms",
      "destination": "/app.html"
    },
    {
      "source": "/privacy",
      "destination": "/app.html"
    },
    {
      "source": "/refund",
      "destination": "/app.html"
    },
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/cart",
      "destination": "/app.html"
    },
    {
      "source": "/history",
      "destination": "/app.html"
    },
    {
      "source": "/dashboard",
      "destination": "/app.html"
    },
    {
      "source": "/reset-password/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/agent",
      "destination": "/app.html"
    },
    {
      "source": "/agent/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
