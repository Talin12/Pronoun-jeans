DEBUG=
SECRET_KEY=
DATABASE_URL=

# Vercel Deploy Hook URL. Optional.
# The storefront is prerendered at build time, so products and categories added
# here have no static HTML until the frontend rebuilds. When this is set,
# products/signals.py POSTs to it on Product/Category save or delete, debounced
# to at most one rebuild per 10 minutes. Leave blank locally and in CI.
# Create one at: Vercel project -> Settings -> Git -> Deploy Hooks
VERCEL_DEPLOY_HOOK=
