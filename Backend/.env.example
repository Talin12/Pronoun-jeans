DEBUG=
SECRET_KEY=
DATABASE_URL=

# Vercel Deploy Hook URL. Optional.
# The storefront is prerendered at build time, so products and categories added
# here have no static HTML until the frontend rebuilds. When this is set,
# products/signals.py POSTs to it on Product/Category save or delete, debounced
# to at most one rebuild per 10 minutes. Leave blank locally and in CI.
# Create one at: Vercel project -> Settings -> Git -> Deploy Hooks
VERCEL_DEPLOY_HOOK=

# ── Google Merchant Center ───────────────────────────────────────────────────
# Drives the "List on Google Merchant" toggle in the admin panel
# (products/merchant.py). All three must be set or the toggle is refused and
# nothing is ever sent to Google — which is what you want locally and in CI.
#
# MERCHANT_ACCOUNT_ID      the Merchant Center account id, top-right in the UI
# MERCHANT_DATA_SOURCE_ID  numeric id of an API-type data source in that
#                          account. Merchant Center > Products > Data sources >
#                          Add product source > API. The hand-built "Merchant
#                          Center" source and the dead "Content API" one will
#                          NOT work: the Merchant API only writes to API sources.
# MERCHANT_SERVICE_ACCOUNT_JSON
#                          the service-account key, either the JSON itself or a
#                          path to the file. That service account also has to be
#                          added as a user on the Merchant Center account.
#
# Account hierarchy matters. 5532741007 is a SUB-ACCOUNT of the advanced
# account 5859053349. Products and data sources live on the sub-account, so
# MERCHANT_ACCOUNT_ID is the sub-account. But the one-off Google Cloud
# project registration (developerRegistration:registerGcp) only works
# against the PARENT, with the service account holding ADMIN there, and it
# needs a verified human user carrying the API_DEVELOPER right. Without
# that, every call returns 401 with a GCP_ reason code that reads like a
# credentials fault but is not one. Already done for this project.
MERCHANT_ACCOUNT_ID=
MERCHANT_DATA_SOURCE_ID=
MERCHANT_SERVICE_ACCOUNT_JSON=

# Optional; the defaults match the listings already live.
# MERCHANT_FEED_LABEL=IN
# MERCHANT_CONTENT_LANGUAGE=en
# MERCHANT_CURRENCY=INR
# MERCHANT_BRAND=PRO-NOUN
# MERCHANT_LANDING_URL=https://www.pronounjeans.com/
# MERCHANT_PRICE_BASIS=per_piece
# MERCHANT_DEFAULT_GENDER=MALE   # the catalogue is menswear; see settings.py
# MERCHANT_DEFAULT_AGE_GROUP=ADULT
